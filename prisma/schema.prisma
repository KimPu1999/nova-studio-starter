  @@index([incidentId, createdAt])
}

model DeveloperApplication {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  workspaceId String?   @db.Uuid
  name        String
  description String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clients     OAuthClient[]

  @@index([userId, status, createdAt])
  @@index([workspaceId, status, createdAt])
}

model OAuthClient {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @db.Uuid
  clientId      String              @unique
  secretHash    String?
  redirectUris  String[]
  scopes        String[]
  clientType    String              @default("PUBLIC")
  status        String              @default("ACTIVE")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  application   DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorizations OAuthAuthorization[]
  tokens        OAuthTokenRecord[]

  @@index([applicationId, status])
}

model OAuthAuthorization {
  id            String      @id @default(uuid()) @db.Uuid
  clientId      String      @db.Uuid
  userId        String      @db.Uuid
  redirectUri   String
  scope         String[]
  codeHash      String      @unique
  codeChallenge String
  challengeMethod String    @default("S256")
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt, consumedAt])
}

model OAuthTokenRecord {
  id             String      @id @default(uuid()) @db.Uuid
  clientId       String      @db.Uuid
  userId         String      @db.Uuid
  workspaceId    String?     @db.Uuid
  accessTokenHash String     @unique
  refreshTokenHash String?   @unique
  scope          String[]
  expiresAt      DateTime
  refreshExpiresAt DateTime?
  revokedAt      DateTime?
  createdAt      DateTime    @default(now())
  client         OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([workspaceId, revokedAt, expiresAt])
}

model ApiUsageEvent {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String?       @db.Uuid
  workspaceId  String?       @db.Uuid
