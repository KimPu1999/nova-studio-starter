generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SUPPORT_AGENT
  CUSTOMER
}

enum AiRequestStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AiLedgerEntryType {
  CREDIT_PURCHASE
  CREDIT_GRANT
  CREDIT_RESERVATION
  CREDIT_CONSUMPTION
  CREDIT_RELEASE
  CREDIT_REFUND
  ADMIN_ADJUSTMENT
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum WebsiteDeploymentStatus {
  DRAFT
  QUEUED
  BUILDING
  READY
  PUBLISHING
  PUBLISHED
  FAILED
  ROLLED_BACK
}

enum WebsiteDomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  PROVISIONING
  ACTIVE
  FAILED
  DISCONNECTED
}

enum HostingSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  DEVELOPER
  VIEWER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

enum WorkspaceApprovalStatus {
  DRAFT
  REQUESTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum SecurityAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum PrivacyRequestType {
  EXPORT
  DELETE
  ACCESS
}

enum PrivacyRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum SecurityIncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RECOVERING
  RESOLVED
  CLOSED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  RETRYING
  FAILED
  DEAD_LETTER
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
}

enum LicenseStatus {
  ACTIVE
  REVOKED
}

enum CouponType {
  FIXED
  PERCENTAGE
}

enum ReviewStatus {
  ACTIVE
  HIDDEN
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum ProductVersionStatus {
  DRAFT
  PUBLISHED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  QUOTED
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ProjectStatus {
  AWAITING_DEPOSIT
  PLANNING
  DESIGN
  DEVELOPMENT
  TESTING
  CLIENT_REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  CHANGES_REQUESTED
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum ProjectInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum ProjectPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectFileVisibility {
  CLIENT
  INTERNAL
}

enum CmsContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ThemeMode {
  DARK
  LIGHT
  SYSTEM
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REVOKED
}

enum CoursePurchaseStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  CANCELLED
  REFUNDED
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADING
  GRADED
  RETURNED
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

enum CourseReviewStatus {
  ACTIVE
  HIDDEN
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MarketingCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum VendorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum VendorProductStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  SUSPENDED
}

enum VendorMemberRole {
  VENDOR_OWNER
  VENDOR_MANAGER
  VENDOR_EDITOR
  VENDOR_FINANCE
}

enum VendorPayoutStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
  CANCELLED
}

enum VendorLedgerEventType {
  SALE_CREDIT
  PLATFORM_COMMISSION
  REFUND_REVERSAL
  PAYOUT_RESERVATION
  PAYOUT_COMPLETION
  PAYOUT_RELEASE
  MANUAL_ADJUSTMENT
}

model User {
  id                            String                     @id @default(uuid()) @db.Uuid
  email                         String                     @unique
  name                          String
  passwordHash                  String
  roleId                        String                     @db.Uuid
  role                          AdminRole                  @relation(fields: [roleId], references: [id])
  sessions                      Session[]
  auditLogs                     AuditLog[]
  carts                         Cart[]
  orders                        Order[]
  paymentSubmissions            PaymentSubmission[]
  paymentReviews                PaymentReview[]
  downloadEntitlements          DownloadEntitlement[]
  downloadEvents                DownloadEvent[]
  passwordResetTokens           PasswordResetToken[]
  wishlistItems                 WishlistItem[]
  reviews                       ProductReview[]
  reviewReports                 ReviewReport[]
  licenses                      CustomerLicense[]
  couponRedemptions             CouponRedemption[]
  projectRequests               ProjectRequest[]
  clientProjects                Project[]                  @relation("ClientProjects")
  assignedProjects              Project[]                  @relation("AssignedProjects")
  assignedRequests              ProjectRequest[]           @relation("RequestAssignee")
  createdProposals              Proposal[]                 @relation("ProposalCreator")
  proposalClients               Proposal[]                 @relation("ProposalClient")
  proposalAcceptances           Proposal[]                 @relation("ProposalAcceptor")
  milestoneAssignments          ProjectMilestone[]         @relation("MilestoneOwner")
  authoredMessages              ProjectMessage[]           @relation("MessageAuthor")
  uploadedProjectFiles          ProjectFile[]              @relation("FileUploader")
  clientInvoices                ProjectInvoice[]           @relation("InvoiceClient")
  reviewedProjectPayments       ProjectPaymentReview[]     @relation("ProjectPaymentReviewer")
  projectPaymentSubmissions     ProjectPaymentSubmission[]
  projectFileEvents             ProjectFileEvent[]
  blogPosts                     BlogPost[]
  siteRevisions                 SiteRevision[]
  projectApprovals              ProjectApproval[]          @relation("ApprovalActor")
  notifications                 Notification[]
  taughtCourses                 Course[]                   @relation("CourseInstructor")
  courseEnrollments             CourseEnrollment[]
  coursePurchases               CoursePurchase[]           @relation("CourseBuyer")
  reviewedCoursePurchases       CoursePurchase[]           @relation("CoursePurchaseReviewer")
  lessonProgress                LessonProgress[]
  quizAttempts                  QuizAttempt[]
  assignmentSubmissions         AssignmentSubmission[]
  courseCertificates            CourseCertificate[]
  courseReviews                 CourseReview[]
  supportTickets                SupportTicket[]            @relation("TicketCustomer")
  assignedSupportTickets        SupportTicket[]            @relation("TicketAgent")
  supportMessages               SupportMessage[]
  supportAttachments            SupportAttachment[]
  supportAssignments            SupportAssignment[]        @relation("SupportAgent")
  assignedSupportTicketsHistory SupportAssignment[]        @relation("AssignedBy")
  supportStatusChanges          SupportStatusHistory[]
  authoredKnowledgeArticles     KnowledgeArticle[]         @relation("KnowledgeAuthor")
  supportFeedback               SupportFeedback[]
  refundRequests                RefundRequest[]            @relation("RefundCustomer")
  reviewedRefunds               RefundRequest[]            @relation("RefundReviewer")
  supportMacros                 SupportMacro[]
  analyticsEvents               AnalyticsEvent[]
  marketingConsent              MarketingConsent?
  createdMarketingCampaigns     MarketingCampaign[]        @relation("CampaignCreator")
  ownedVendorProfiles           VendorProfile[]            @relation("VendorOwner")
  vendorApplications            VendorApplication[]        @relation("VendorApplicant")
  reviewedVendorApplications    VendorApplication[]        @relation("VendorReviewer")
  vendorMemberships             VendorMember[]
  vendorLedgerEntries           VendorLedgerEntry[]
  vendorPayoutReviews           VendorPayoutRequest[]      @relation("PayoutReviewer")
  vendorCommissionRulesCreated  VendorCommissionRule[]
  confirmedVendorPayouts        VendorPayoutTransaction[]
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  lastLoginAt                   DateTime?
  aiConversations               AiConversation[]
  aiWebsiteProjects             AiWebsiteProject[]
  aiCreditWallet                AiCreditWallet?
  aiCreditLedgerEntries         AiCreditLedger[]
  aiUsageRecords                AiUsageRecord[]
  aiSafetyEvents                AiSafetyEvent[]
  aiGenerationJobs              AiGenerationJob[]
  aiRevisionAuthors             AiWebsiteRevision[]
  hostedWebsites                HostedWebsite[]
  hostingSubscriptions          HostingSubscription[]
  hostingInvoices               HostingInvoice[]
  hostingPayments               HostingPayment[]
  reviewedHostingPayments       HostingPayment[]       @relation("HostingPaymentReviewer")
  hostingAuditLogs              WebsiteHostingAuditLog[]
  ownedOrganizations            Organization[]             @relation("OrganizationOwner")
  createdOrganizations          Organization[]             @relation("OrganizationCreator")
  workspaceMemberships          WorkspaceMember[]
  sentWorkspaceInvitations      WorkspaceInvitation[]      @relation("InvitationSender")
  acceptedWorkspaceInvitations  WorkspaceInvitation[]      @relation("InvitationAcceptor")
  createdWorkspaceProjects      WorkspaceProject[]          @relation("WorkspaceProjectCreator")
  workspaceProjectMemberships   WorkspaceProjectMember[]
  createdWorkspaceAssets        WorkspaceAsset[]             @relation("AssetCreator")
  createdBrandKits              WorkspaceBrandKit[]          @relation("BrandKitCreator")
  createdAgencyClients          AgencyClient[]                @relation("AgencyClientCreator")
  agencyClientMemberships      AgencyClientMember[]
  requestedClientApprovals      ClientApprovalRequest[]       @relation("ApprovalRequester")
  reviewedClientApprovals       ClientApprovalRequest[]       @relation("ApprovalReviewer")
  workspaceAuditEvents          WorkspaceAuditLog[]
  workspaceCreditActions        WorkspaceCreditLedger[]
  mfaCredential                 MfaCredential?
  securityEvents                SecurityEvent[]
  securityAlerts                SecurityAlert[]           @relation("AlertActor")
  apiCredentials               ApiCredential[]
  createdServiceAccounts       ServiceAccount[]          @relation("ServiceAccountCreator")
  privacyRequests              PrivacyRequest[]
  securityIncidents            SecurityIncident[]         @relation("IncidentOwner")
  securityAuditEvents          SecurityAuditLog[]
  securitySessions             SecuritySession[]
  updatedSecurityPolicies      SecurityPolicy[]            @relation("SecurityPolicyUpdater")
  reviewedPrivacyRequests      PrivacyRequest[]            @relation("PrivacyReviewer")
  updatedRetentionPolicies     DataRetentionPolicy[]       @relation("RetentionPolicyUpdater")
  securityIncidentEvents       SecurityIncidentEvent[]
  developerApplications        DeveloperApplication[]
  oauthAuthorizations          OAuthAuthorization[]
  oauthTokens                  OAuthTokenRecord[]
  apiUsageEvents               ApiUsageEvent[]
  integrationConnections       IntegrationConnection[]
  developerSandboxes           DeveloperSandbox[]
  apiAuditEvents               ApiAuditLog[]

  @@index([roleId])
}

model CourseCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model Course {
  id                       String              @id @default(uuid()) @db.Uuid
  title                    String
  slug                     String              @unique
  description              String
  thumbnailStorageKey      String?
  categoryId               String              @db.Uuid
  instructorId             String              @db.Uuid
  difficulty               String              @default("Beginner")
  language                 String              @default("en")
  priceMmk                 Int                 @default(0)
  isFree                   Boolean             @default(true)
  estimatedDurationMinutes Int?
  prerequisites            String[]            @default([])
  learningOutcomes         String[]            @default([])
  requirements             String[]            @default([])
  status                   CourseStatus        @default(DRAFT)
  isFeatured               Boolean             @default(false)
  publishedAt              DateTime?
  category                 CourseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  instructor               User                @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  sections                 CourseSection[]
  enrollments              CourseEnrollment[]
  purchases                CoursePurchase[]
  reviews                  CourseReview[]
  certificates             CourseCertificate[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([instructorId, status])
  @@index([isFeatured, status])
}

model CourseSection {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  title       String
  description String?
  sortOrder   Int      @default(0)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, sortOrder])
}

model Lesson {
  id                   String           @id @default(uuid()) @db.Uuid
  sectionId            String           @db.Uuid
  title                String
  slug                 String
  description          String?
  content              Json?
  lessonType           LessonType       @default(ARTICLE)
  videoStorageKey      String?
  videoDurationSeconds Int?
  sortOrder            Int              @default(0)
  isPreview            Boolean          @default(false)
  isPublished          Boolean          @default(false)
  section              CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resources            LessonResource[]
  progress             LessonProgress[]
  quiz                 Quiz?
  assignment           Assignment?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([sectionId, slug])
  @@index([sectionId, sortOrder])
  @@index([isPublished, isPreview])
}

model LessonResource {
  id         String   @id @default(uuid()) @db.Uuid
  lessonId   String   @db.Uuid
  name       String
  storageKey String
  fileName   String
  mimeType   String
  fileSize   Int
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([lessonId, createdAt])
}

model CourseEnrollment {
  id             String              @id @default(uuid()) @db.Uuid
  courseId       String              @db.Uuid
  studentId      String              @db.Uuid
  purchaseId     String?             @unique @db.Uuid
  status         EnrollmentStatus    @default(ACTIVE)
  enrolledAt     DateTime            @default(now())
  completedAt    DateTime?
  course         Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  purchase       CoursePurchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  progress       LessonProgress[]
  certificates   CourseCertificate[]
  supportTickets SupportTicket[]

  @@unique([courseId, studentId])
  @@index([studentId, status, enrolledAt])
}

model LessonProgress {
  id                  String           @id @default(uuid()) @db.Uuid
  enrollmentId        String           @db.Uuid
  lessonId            String           @db.Uuid
  studentId           String           @db.Uuid
  completed           Boolean          @default(false)
  lastPositionSeconds Int              @default(0)
  completedAt         DateTime?
  enrollment          CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson              Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student             User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([studentId, completed])
}

model Quiz {
  id               String         @id @default(uuid()) @db.Uuid
  lessonId         String         @unique @db.Uuid
  instructions     String?
  timeLimitSeconds Int?
  passingScore     Int            @default(70)
  attemptLimit     Int            @default(3)
  randomize        Boolean        @default(false)
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions        QuizQuestion[]
  attempts         QuizAttempt[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model QuizQuestion {
  id            String           @id @default(uuid()) @db.Uuid
  quizId        String           @db.Uuid
  prompt        String
  questionType  QuizQuestionType
  options       Json
  correctAnswer Json
  points        Int              @default(1)
  sortOrder     Int              @default(0)
  quiz          Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers       QuizAnswer[]

  @@index([quizId, sortOrder])
}

model QuizAttempt {
  id            String       @id @default(uuid()) @db.Uuid
  quizId        String       @db.Uuid
  studentId     String       @db.Uuid
  attemptNumber Int
  score         Int?
  passed        Boolean      @default(false)
  startedAt     DateTime     @default(now())
  submittedAt   DateTime?
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student       User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers       QuizAnswer[]

  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId, submittedAt])
}

model QuizAnswer {
  id           String       @id @default(uuid()) @db.Uuid
  attemptId    String       @db.Uuid
  questionId   String       @db.Uuid
  answer       Json
  isCorrect    Boolean?
  pointsEarned Int          @default(0)
  attempt      QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question     QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
}

model Assignment {
  id                String                 @id @default(uuid()) @db.Uuid
  lessonId          String                 @unique @db.Uuid
  instructions      String
  deadline          DateTime?
  maxScore          Int                    @default(100)
  allowResubmission Boolean                @default(true)
  lesson            Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions       AssignmentSubmission[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model AssignmentSubmission {
  id           String                     @id @default(uuid()) @db.Uuid
  assignmentId String                     @db.Uuid
  studentId    String                     @db.Uuid
  text         String?
  storageKey   String?
  fileName     String?
  mimeType     String?
  fileSize     Int?
  status       AssignmentSubmissionStatus @default(SUBMITTED)
  grade        Int?
  feedback     String?
  submittedAt  DateTime                   @default(now())
  gradedAt     DateTime?
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User                       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, studentId, submittedAt])
}

model CourseCertificate {
  id                String            @id @default(uuid()) @db.Uuid
  enrollmentId      String            @db.Uuid
  studentId         String            @db.Uuid
  courseId          String            @db.Uuid
  certificateNumber String            @unique
  verificationCode  String            @unique
  issuedAt          DateTime          @default(now())
  status            CertificateStatus @default(ACTIVE)
  revokedAt         DateTime?
  enrollment        CourseEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student           User              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, courseId])
  @@index([studentId, issuedAt])
}

model CourseReview {
  id        String             @id @default(uuid()) @db.Uuid
  courseId  String             @db.Uuid
  studentId String             @db.Uuid
  rating    Int
  title     String
  content   String
  status    CourseReviewStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId, status, createdAt])
}

model CoursePurchase {
  id                   String               @id @default(uuid()) @db.Uuid
  purchaseNumber       String               @unique
  courseId             String               @db.Uuid
  buyerId              String               @db.Uuid
  unitPriceMmk         Int
  currency             String               @default("MMK")
  status               CoursePurchaseStatus @default(PENDING_PAYMENT)
  paymentMethodId      String?              @db.Uuid
  transactionReference String?
  proofStorageKey      String?
  proofMimeType        String?
  idempotencyKey       String               @unique
  reviewerId           String?              @db.Uuid
  reviewedAt           DateTime?
  rejectionReason      String?
  course               Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  buyer                User                 @relation("CourseBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  paymentMethod        PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  reviewer             User?                @relation("CoursePurchaseReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  enrollment           CourseEnrollment?
  refundRequests       RefundRequest[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([courseId, status, createdAt])
  @@index([buyerId, status, createdAt])
}

model AdminRole {
  id        String   @id @default(uuid()) @db.Uuid
  code      RoleCode @unique
  name      String
  users     User[]
  createdAt DateTime @default(now())
}

model Template {
  id                   String                @id @default(uuid()) @db.Uuid
  slug                 String                @unique
  name                 String
  description          String
  priceMmk             Int
  demoUrl              String?
  thumbnailUrl         String?
  technology           String[]
  licenseType          String
  status               TemplateStatus        @default(DRAFT)
  vendorId             String?               @db.Uuid
  vendorStatus         VendorProductStatus   @default(APPROVED)
  categoryId           String                @db.Uuid
  category             Category              @relation(fields: [categoryId], references: [id])
  vendor               VendorProfile?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  images               TemplateImage[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  downloadEntitlements DownloadEntitlement[]
  licensePrices        ProductLicensePrice[]
  versions             ProductVersion[]
  wishlistItems        WishlistItem[]
  reviews              ProductReview[]
  licenses             CustomerLicense[]
  couponProducts       CouponProduct[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  publishedAt          DateTime?
  sourceFileStorageKey String?
  sourceFileName       String?
  sourceFileSize       Int?

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([vendorId, vendorStatus, status])
}

model Category {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String                 @unique
  slug                  String                 @unique
  templates             Template[]
  vendorCommissionRules VendorCommissionRule[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model TemplateImage {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([templateId, sortOrder])
}

model Service {
  id                    String        @id @default(uuid()) @db.Uuid
  name                  String        @unique
  slug                  String        @unique
  description           String
  isActive              Boolean       @default(true)
  status                ServiceStatus @default(DRAFT)
  category              String        @default("Custom Web Application")
  includedFeatures      String[]      @default([])
  estimatedDeliveryDays Int?
