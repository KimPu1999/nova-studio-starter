generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CUSTOMER
}
enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  CANCELLED
  REFUNDED
}
enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String
  roleId       String       @db.Uuid
  role         AdminRole    @relation(fields: [roleId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  carts        Cart[]
  orders       Order[]
  paymentSubmissions PaymentSubmission[]
  paymentReviews PaymentReview[]
  downloadEntitlements DownloadEntitlement[]
  downloadEvents DownloadEvent[]
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastLoginAt  DateTime?
  @@index([roleId])
}

model AdminRole {
  id          String    @id @default(uuid()) @db.Uuid
  code        RoleCode  @unique
  name        String
  users       User[]
  createdAt   DateTime  @default(now())
}

model Template {
  id            String          @id @default(uuid()) @db.Uuid
  slug          String          @unique
  name          String
  description   String
  priceMmk      Int
  demoUrl       String?
  thumbnailUrl  String?
  technology    String[]
  licenseType   String
  status        TemplateStatus  @default(DRAFT)
  categoryId    String          @db.Uuid
  category      Category        @relation(fields: [categoryId], references: [id])
  images        TemplateImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  downloadEntitlements DownloadEntitlement[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  publishedAt   DateTime?
  sourceFileStorageKey String?
  sourceFileName String?
  sourceFileSize Int?
  @@index([status, createdAt])
  @@index([categoryId, status])
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  slug      String     @unique
  templates Template[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model TemplateImage {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  @@index([templateId, sortOrder])
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShowcaseProject {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  description String
  imageUrl    String?
  projectUrl  String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([isPublished, createdAt])
}

model Inquiry {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  email       String
  projectType String
  message     String
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([status, createdAt])
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @db.Uuid
  templateId String   @db.Uuid
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  @@unique([cartId, templateId])
  @@index([templateId])
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus   @default(PENDING_PAYMENT)
  currency        String        @default("MMK")
  subtotalMmk     Int
  totalMmk        Int
  customerName    String
  customerEmail   String
  customerPhone   String
  orderNotes      String?
  idempotencyKey  String
  items           OrderItem[]
  payments        PaymentSubmission[]
  entitlements    DownloadEntitlement[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?
  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @db.Uuid
  templateId     String?   @db.Uuid
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template       Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName   String
  templateSlug   String
  unitPriceMmk   Int
  currency       String    @default("MMK")
  quantity       Int       @default(1)
  createdAt      DateTime  @default(now())
  @@unique([orderId, templateSlug])
  @@index([templateId])
}

model PaymentMethod {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  accountHolderName String
  walletNumber    String
  qrStorageKey    String?
  instructions    String
  isEnabled       Boolean  @default(false)
  displayOrder    Int      @default(0)
  payments        PaymentSubmission[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([isEnabled, displayOrder])
}

model PaymentSubmission {
  id                    String                   @id @default(uuid()) @db.Uuid
  orderId               String                   @db.Uuid
  paymentMethodId       String                   @db.Uuid
  submittedById         String                   @db.Uuid
  amountMmk             Int
  currency              String                   @default("MMK")
  transactionReference  String
  proofStorageKey        String
  proofMimeType          String
  status                PaymentSubmissionStatus @default(PENDING)
  idempotencyKey        String                   @unique
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod         PaymentMethod            @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  submittedBy           User                     @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  review                PaymentReview?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  @@index([orderId, status, createdAt])
  @@index([submittedById, createdAt])
}

model PaymentReview {
  id             String                   @id @default(uuid()) @db.Uuid
  submissionId   String                   @unique @db.Uuid
  reviewerId     String                   @db.Uuid
  decision       PaymentSubmissionStatus
  rejectionReason String?
  verifiedNote   String?
  reviewedAt     DateTime                 @default(now())
  submission     PaymentSubmission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer       User                     @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  @@index([reviewerId, reviewedAt])
}

model DownloadEntitlement {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @db.Uuid
  templateId     String    @db.Uuid
  userId         String    @db.Uuid
  maxDownloads   Int       @default(5)
  downloadCount  Int       @default(0)
  tokenVersion   Int       @default(1)
  revokedAt      DateTime?
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template       Template  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  downloadEvents DownloadEvent[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@unique([orderId, templateId])
  @@unique([orderId, templateId, userId])
  @@index([userId, revokedAt])
}

model DownloadEvent {
  id            String              @id @default(uuid()) @db.Uuid
  entitlementId String              @db.Uuid
  userId        String              @db.Uuid
  ipHash        String?
  userAgent     String?
  createdAt     DateTime            @default(now())
  entitlement   DownloadEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([entitlementId, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}
