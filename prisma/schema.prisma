  apiKeysEnabled     Boolean      @default(true)
  securityNotifications Boolean   @default(true)
  updatedById        String?      @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace          Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy          User?        @relation("SecurityPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model IdentityProviderConfig {
