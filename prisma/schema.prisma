  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
}

model WebhookEndpoint {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  url         String
  status      String            @default("ACTIVE")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriptions WebhookSubscription[]
  deliveries  WebhookDelivery[]
  secrets     WebhookSigningSecret[]

  @@index([workspaceId, status, createdAt])
}

model WebhookSubscription {
  id         String          @id @default(uuid()) @db.Uuid
  endpointId String          @db.Uuid
  eventType  String
  version    String          @default("2026-11-12")
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  endpoint   WebhookEndpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventType, version])
}

model WebhookEvent {
  id          String              @id @default(uuid()) @db.Uuid
  eventId     String              @unique
  workspaceId String?             @db.Uuid
  eventType   String
  version     String
  payload     Json
  createdAt   DateTime            @default(now())
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([workspaceId, eventType, createdAt])
}

model WebhookDelivery {
  id           String               @id @default(uuid()) @db.Uuid
  eventId      String               @db.Uuid
  endpointId   String               @db.Uuid
  status       WebhookDeliveryStatus @default(PENDING)
  attemptCount Int                  @default(0)
  nextAttemptAt DateTime?
  lastStatusCode Int?
  lastAttemptAt DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime             @default(now())
  event        WebhookEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint      @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts     WebhookDeliveryAttempt[]

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

model WebhookSigningSecret {
  id              String          @id @default(uuid()) @db.Uuid
  endpointId      String          @db.Uuid
  secretCiphertext String
  version         Int             @default(1)
  revokedAt       DateTime?
  createdAt       DateTime        @default(now())
  endpoint        WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, revokedAt, createdAt])
}

