generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CUSTOMER
}
enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  CANCELLED
  REFUNDED
}
enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
enum LicenseStatus {
  ACTIVE
  REVOKED
}
enum CouponType {
  FIXED
  PERCENTAGE
}
enum ReviewStatus {
  ACTIVE
  HIDDEN
}
enum ReportStatus {
  OPEN
  RESOLVED
}
enum ProductVersionStatus {
  DRAFT
  PUBLISHED
}
enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum ProjectRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  QUOTED
  ACCEPTED
  DECLINED
  CANCELLED
}
enum ProjectStatus {
  AWAITING_DEPOSIT
  PLANNING
  DESIGN
  DEVELOPMENT
  TESTING
  CLIENT_REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}
enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}
enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  CHANGES_REQUESTED
  COMPLETED
}
enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}
enum ProjectInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}
enum ProjectPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ProjectFileVisibility {
  CLIENT
  INTERNAL
}
enum CmsContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum ThemeMode {
  DARK
  LIGHT
  SYSTEM
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String
  roleId       String       @db.Uuid
  role         AdminRole    @relation(fields: [roleId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  carts        Cart[]
  orders       Order[]
  paymentSubmissions PaymentSubmission[]
  paymentReviews PaymentReview[]
  downloadEntitlements DownloadEntitlement[]
  downloadEvents DownloadEvent[]
  passwordResetTokens PasswordResetToken[]
  wishlistItems WishlistItem[]
  reviews ProductReview[]
  reviewReports ReviewReport[]
  licenses CustomerLicense[]
  couponRedemptions CouponRedemption[]
  projectRequests ProjectRequest[]
  clientProjects Project[] @relation("ClientProjects")
  assignedProjects Project[] @relation("AssignedProjects")
  assignedRequests ProjectRequest[] @relation("RequestAssignee")
  createdProposals Proposal[] @relation("ProposalCreator")
  proposalClients Proposal[] @relation("ProposalClient")
  proposalAcceptances Proposal[] @relation("ProposalAcceptor")
  milestoneAssignments ProjectMilestone[] @relation("MilestoneOwner")
  authoredMessages ProjectMessage[] @relation("MessageAuthor")
  uploadedProjectFiles ProjectFile[] @relation("FileUploader")
  clientInvoices ProjectInvoice[] @relation("InvoiceClient")
  reviewedProjectPayments ProjectPaymentReview[] @relation("ProjectPaymentReviewer")
  projectPaymentSubmissions ProjectPaymentSubmission[]
  projectFileEvents ProjectFileEvent[]
  blogPosts BlogPost[]
  siteRevisions SiteRevision[]
  projectApprovals ProjectApproval[] @relation("ApprovalActor")
  notifications Notification[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastLoginAt  DateTime?
  @@index([roleId])
}

model AdminRole {
  id          String    @id @default(uuid()) @db.Uuid
  code        RoleCode  @unique
  name        String
  users       User[]
  createdAt   DateTime  @default(now())
}

model Template {
  id            String          @id @default(uuid()) @db.Uuid
  slug          String          @unique
  name          String
  description   String
  priceMmk      Int
  demoUrl       String?
  thumbnailUrl  String?
  technology    String[]
  licenseType   String
  status        TemplateStatus  @default(DRAFT)
  categoryId    String          @db.Uuid
  category      Category        @relation(fields: [categoryId], references: [id])
  images        TemplateImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  downloadEntitlements DownloadEntitlement[]
  licensePrices ProductLicensePrice[]
  versions ProductVersion[]
  wishlistItems WishlistItem[]
  reviews ProductReview[]
  licenses CustomerLicense[]
  couponProducts CouponProduct[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  publishedAt   DateTime?
  sourceFileStorageKey String?
  sourceFileName String?
  sourceFileSize Int?
  @@index([status, createdAt])
  @@index([categoryId, status])
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  slug      String     @unique
  templates Template[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model TemplateImage {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  @@index([templateId, sortOrder])
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String
  isActive    Boolean  @default(true)
  status      ServiceStatus @default(DRAFT)
  category    String    @default("Custom Web Application")
  includedFeatures String[] @default([])
  estimatedDeliveryDays Int?
  startingPriceMmk Int?
  customQuotation Boolean @default(false)
  faq         Json?
  ctaText     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShowcaseProject {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  description String
  imageUrl    String?
  projectUrl  String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([isPublished, createdAt])
}

model Inquiry {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  email       String
  projectType String
  message     String
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([status, createdAt])
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandSetting {
  id             String   @id @default(uuid()) @db.Uuid
  singletonKey   String   @unique @default("default")
  brandName      String   @default("NOVA Studio")
  brandDescription String?
  logoStorageKey String?
  darkLogoStorageKey String?
  lightLogoStorageKey String?
  faviconStorageKey String?
  primaryColor   String   @default("#8B5CF6")
  secondaryColor String   @default("#171725")
  accentColor    String   @default("#22D3EE")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model AppearanceSetting {
  id             String   @id @default(uuid()) @db.Uuid
  singletonKey   String   @unique @default("default")
  mode           ThemeMode @default(DARK)
  backgroundColor String  @default("#09090F")
  surfaceColor   String   @default("#171725")
  primaryColor   String   @default("#8B5CF6")
  accentColor    String   @default("#22D3EE")
  textColor      String   @default("#F8FAFC")
  headingFont    String   @default("Inter")
  bodyFont       String   @default("Inter")
  borderRadius   String   @default("medium")
  buttonStyle    String   @default("rounded")
  cardStyle      String   @default("bordered")
  layoutWidth    String   @default("wide")
  reduceMotion   Boolean  @default(false)
  isPublished    Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model HomepageSection {
  id          String   @id @default(uuid()) @db.Uuid
  sectionKey  String   @unique
  title       String
  content     Json
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  status      CmsContentStatus @default(DRAFT)
  publishedAt DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  @@index([status, sortOrder])
}

model NavigationMenu {
  id          String   @id @default(uuid()) @db.Uuid
  location    String   @unique
  name        String
  status      CmsContentStatus @default(DRAFT)
  items       NavigationItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NavigationItem {
  id          String   @id @default(uuid()) @db.Uuid
  menuId      String   @db.Uuid
  parentId    String?  @db.Uuid
  label       String
  href        String
  openInNewTab Boolean @default(false)
  sortOrder   Int      @default(0)
  menu        NavigationMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent      NavigationItem? @relation("NavigationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    NavigationItem[] @relation("NavigationTree")
  @@index([menuId, sortOrder])
}

model CmsPage {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  content     Json
  status      CmsContentStatus @default(DRAFT)
  seoTitle    String?
  seoDescription String?
  canonicalUrl String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, updatedAt])
}

model BlogCategory {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
}

model BlogPost {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  title          String
  excerpt        String
  content        Json
  featuredImageStorageKey String?
  status         BlogPostStatus @default(DRAFT)
  categoryId     String?  @db.Uuid
  authorId       String   @db.Uuid
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  readingTimeMinutes Int  @default(1)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author         User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags           BlogPostTag[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status, publishedAt])
  @@index([categoryId, status])
}

model BlogTag {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  slug      String       @unique
  posts     BlogPostTag[]
}

model BlogPostTag {
  postId String   @db.Uuid
  tagId  String   @db.Uuid
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([postId, tagId])
}

model SeoMetadata {
  id             String   @id @default(uuid()) @db.Uuid
  routeKey       String   @unique
  metaTitle      String
  metaDescription String
  ogImageStorageKey String?
  canonicalUrl   String?
  robots         String   @default("index,follow")
  structuredData Json?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model ContentTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  locale      String
  entityType  String
  entityId    String
  field       String
  value       String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([locale, entityType, entityId, field])
  @@index([locale, entityType, entityId])
}

model EmailTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  subject     String
  body        String
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model SocialLink {
  id          String   @id @default(uuid()) @db.Uuid
  platform    String   @unique
  label       String
  url         String
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([isEnabled, sortOrder])
}

model SiteRevision {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String
  entityId    String
  action      String
  before      Json?
  after       Json?
  changedById String   @db.Uuid
  changedBy   User     @relation(fields: [changedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  @@index([entityType, entityId, createdAt])
  @@index([changedById, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @db.Uuid
  templateId String   @db.Uuid
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  licenseTypeId String? @db.Uuid
  licenseType ProductLicenseType? @relation(fields: [licenseTypeId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  @@unique([cartId, templateId])
  @@index([templateId])
  @@index([licenseTypeId])
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus   @default(PENDING_PAYMENT)
  currency        String        @default("MMK")
  subtotalMmk     Int
  totalMmk        Int
  customerName    String
  customerEmail   String
  customerPhone   String
  orderNotes      String?
  couponId        String?
  couponCode      String?
  discountMmk     Int           @default(0)
  idempotencyKey  String
  items           OrderItem[]
  payments        PaymentSubmission[]
  entitlements    DownloadEntitlement[]
  licenses        CustomerLicense[]
  couponRedemptions CouponRedemption[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?
  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @db.Uuid
  templateId     String?   @db.Uuid
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template       Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName   String
  templateSlug   String
  unitPriceMmk   Int
  currency       String    @default("MMK")
  quantity       Int       @default(1)
  licenseTypeId  String? @db.Uuid
  licenseType    ProductLicenseType? @relation(fields: [licenseTypeId], references: [id], onDelete: SetNull)
  licenseTypeCode String?
  licensePriceMmk Int?
  licenseTermsSnapshot String?
  licenseAllowedUsageSnapshot String?
  license CustomerLicense?
  review ProductReview?
  createdAt      DateTime  @default(now())
  @@unique([orderId, templateSlug])
  @@index([templateId])
  @@index([licenseTypeId])
}

model PaymentMethod {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  accountHolderName String
  walletNumber    String
  qrStorageKey    String?
  instructions    String
  isEnabled       Boolean  @default(false)
  displayOrder    Int      @default(0)
  payments        PaymentSubmission[]
  projectPayments ProjectPaymentSubmission[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([isEnabled, displayOrder])
}

model PaymentSubmission {
  id                    String                   @id @default(uuid()) @db.Uuid
  orderId               String                   @db.Uuid
  paymentMethodId       String                   @db.Uuid
  submittedById         String                   @db.Uuid
  amountMmk             Int
  currency              String                   @default("MMK")
  transactionReference  String
  proofStorageKey        String
  proofMimeType          String
  status                PaymentSubmissionStatus @default(PENDING)
  idempotencyKey        String                   @unique
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod         PaymentMethod            @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  submittedBy           User                     @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  review                PaymentReview?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  @@index([orderId, status, createdAt])
  @@index([submittedById, createdAt])
}

model PaymentReview {
  id             String                   @id @default(uuid()) @db.Uuid
  submissionId   String                   @unique @db.Uuid
  reviewerId     String                   @db.Uuid
  decision       PaymentSubmissionStatus
  rejectionReason String?
  verifiedNote   String?
  reviewedAt     DateTime                 @default(now())
  submission     PaymentSubmission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer       User                     @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  @@index([reviewerId, reviewedAt])
}

model DownloadEntitlement {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @db.Uuid
  templateId     String    @db.Uuid
  userId         String    @db.Uuid
  maxDownloads   Int       @default(5)
  downloadCount  Int       @default(0)
  tokenVersion   Int       @default(1)
  revokedAt      DateTime?
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template       Template  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  downloadEvents DownloadEvent[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@unique([orderId, templateId])
  @@unique([orderId, templateId, userId])
  @@index([userId, revokedAt])
}

model DownloadEvent {
  id            String              @id @default(uuid()) @db.Uuid
  entitlementId String              @db.Uuid
  userId        String              @db.Uuid
  ipHash        String?
  userAgent     String?
  createdAt     DateTime            @default(now())
  entitlement   DownloadEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([entitlementId, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model ProductLicenseType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  defaultTerms String
  defaultAllowedUsage String
  isActive    Boolean  @default(true)
  prices      ProductLicensePrice[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  licenses    CustomerLicense[]
  couponLicenses CouponLicenseType[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductLicensePrice {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  licenseTypeId String   @db.Uuid
  priceMmk      Int
  licenseTerms  String
  allowedUsage  String
  isActive      Boolean  @default(true)
  product       Template @relation(fields: [productId], references: [id], onDelete: Cascade)
  licenseType   ProductLicenseType @relation(fields: [licenseTypeId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([productId, licenseTypeId])
  @@index([productId, isActive])
}

model CustomerLicense {
  id             String        @id @default(uuid()) @db.Uuid
  productId      String        @db.Uuid
  licenseTypeId  String        @db.Uuid
  orderId        String        @db.Uuid
  orderItemId    String        @unique @db.Uuid
  customerId     String        @db.Uuid
  priceMmk       Int
  licenseTerms   String
  allowedUsage   String
  licenseKey     String        @unique
  status         LicenseStatus @default(ACTIVE)
  issuedAt       DateTime      @default(now())
  revokedAt      DateTime?
  revocationReason String?
  product        Template      @relation(fields: [productId], references: [id], onDelete: Restrict)
  licenseType    ProductLicenseType @relation(fields: [licenseTypeId], references: [id], onDelete: Restrict)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem      OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  customer       User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([customerId, status, createdAt])
  @@index([productId, status])
}

model ProductVersion {
  id            String              @id @default(uuid()) @db.Uuid
  productId     String              @db.Uuid
  versionNumber String
  changelog     String
  releaseNotes  String?
  releaseDate   DateTime            @default(now())
  status        ProductVersionStatus @default(DRAFT)
  updatePolicy  String              @default("ACTIVE_LICENSE")
  product       Template            @relation(fields: [productId], references: [id], onDelete: Cascade)
  files         ProductVersionFile[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  @@unique([productId, versionNumber])
  @@index([productId, status, releaseDate])
}

model ProductVersionFile {
  id          String         @id @default(uuid()) @db.Uuid
  versionId   String         @unique @db.Uuid
  storageKey  String
  fileSize    Int
  checksum    String
  version     ProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Coupon {
  id                 String          @id @default(uuid()) @db.Uuid
  code               String          @unique
  type               CouponType
  amount             Int
  startsAt           DateTime?
  expiresAt          DateTime?
  maxUsageCount      Int?
  perCustomerLimit   Int?
  minimumOrderMmk    Int             @default(0)
  isActive           Boolean         @default(true)
  products           CouponProduct[]
  licenseTypes       CouponLicenseType[]
  redemptions        CouponRedemption[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  @@index([isActive, startsAt, expiresAt])
}

model CouponProduct {
  couponId  String   @db.Uuid
  productId String   @db.Uuid
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Template @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([couponId, productId])
}

model CouponLicenseType {
  couponId      String             @db.Uuid
  licenseTypeId String             @db.Uuid
  coupon        Coupon             @relation(fields: [couponId], references: [id], onDelete: Cascade)
  licenseType   ProductLicenseType @relation(fields: [licenseTypeId], references: [id], onDelete: Cascade)
  @@id([couponId, licenseTypeId])
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @db.Uuid
  customerId     String   @db.Uuid
  orderId        String   @unique @db.Uuid
  discountMmk    Int
  redeemedAt     DateTime?
  releasedAt     DateTime?
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  customer       User     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  @@index([couponId, redeemedAt])
  @@index([customerId, couponId])
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Template @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([customerId, productId])
  @@index([customerId, createdAt])
}

model ProductReview {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid
  customerId  String       @db.Uuid
  orderItemId String       @unique @db.Uuid
  rating      Int
  title       String
  content     String
  status      ReviewStatus @default(ACTIVE)
  product     Template     @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer    User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  reports     ReviewReport[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@unique([productId, customerId])
  @@index([productId, status, createdAt])
}

model ReviewReport {
  id         String       @id @default(uuid()) @db.Uuid
  reviewId   String       @db.Uuid
  reporterId String       @db.Uuid
  reason     String
  status     ReportStatus @default(OPEN)
  review     ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  @@index([status, createdAt])
}

model ProjectRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  requestNumber       String              @unique
  customerId          String              @db.Uuid
  assignedAdminId     String?             @db.Uuid
  status              ProjectRequestStatus @default(DRAFT)
  companyName         String?
  websiteType         String
  title               String
  description         String
  requiredPages       String[] @default([])
  requiredFeatures    String[] @default([])
  preferredTechnology String?
  budgetMinMmk        Int?
  budgetMaxMmk        Int?
  desiredDeadline     DateTime?
  referenceUrls       String[] @default([])
  additionalNotes     String?
  internalNotes       String?
  idempotencyKey      String
  customer            User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAdmin       User?               @relation("RequestAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  attachments         ProjectRequestAttachment[]
  proposals           Proposal[]
  project             Project?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  submittedAt         DateTime?
  @@unique([customerId, idempotencyKey])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model ProjectRequestAttachment {
  id          String        @id @default(uuid()) @db.Uuid
  requestId   String        @db.Uuid
  storageKey  String
  fileName    String
  mimeType    String
  fileSize    Int
  request     ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  @@index([requestId, createdAt])
}

model Proposal {
  id                    String         @id @default(uuid()) @db.Uuid
  proposalNumber        String         @unique
  requestId             String         @db.Uuid
  clientId              String         @db.Uuid
  createdById           String         @db.Uuid
  acceptedById          String?        @db.Uuid
  status                ProposalStatus @default(DRAFT)
  currentVersionNumber  Int            @default(1)
  acceptedAt            DateTime?
  acceptedTermsSnapshot String?
  request               ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  client                User           @relation("ProposalClient", fields: [clientId], references: [id], onDelete: Restrict)
  createdBy             User           @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedBy            User?          @relation("ProposalAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  versions              ProposalVersion[]
  project               Project?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  @@index([clientId, status, createdAt])
  @@index([requestId, createdAt])
}

model ProposalVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  proposalId         String    @db.Uuid
  versionNumber      Int
  projectScope       String
  deliverables       String[]
  technologyStack    String[]
  estimatedTimeline  String
  subtotalMmk        Int
  discountMmk        Int       @default(0)
  totalMmk           Int
  paymentSchedule    Json
  termsAndConditions String
  expirationDate     DateTime
  proposal           Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  items              ProposalItem[]
  createdAt          DateTime  @default(now())
  @@unique([proposalId, versionNumber])
  @@index([proposalId, createdAt])
}

model ProposalItem {
  id          String         @id @default(uuid()) @db.Uuid
  versionId   String         @db.Uuid
  description String
  quantity    Int            @default(1)
  unitPriceMmk Int
  totalMmk    Int
  version     ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model Project {
  id                   String        @id @default(uuid()) @db.Uuid
  projectNumber        String        @unique
  requestId            String        @unique @db.Uuid
  proposalId           String        @unique @db.Uuid
  clientId             String        @db.Uuid
  assignedAdminId      String?       @db.Uuid
  status               ProjectStatus @default(AWAITING_DEPOSIT)
  budgetMmk            Int
  startDate            DateTime?
  targetCompletionDate DateTime?
  request              ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  proposal             Proposal      @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  client               User          @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  assignedAdmin        User?         @relation("AssignedProjects", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  milestones           ProjectMilestone[]
  approvals            ProjectApproval[]
  messages             ProjectMessage[]
  files                ProjectFile[]
  invoices             ProjectInvoice[]
  activities           ProjectActivity[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  @@index([status, updatedAt])
  @@index([clientId, status])
  @@index([assignedAdminId, status])
}

model ProjectMilestone {
  id          String          @id @default(uuid()) @db.Uuid
  projectId   String          @db.Uuid
  ownerId     String?         @db.Uuid
  name        String
  description String?
  weight      Int
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?           @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvals   ProjectApproval[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([projectId, status, dueDate])
}

model ProjectApproval {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  milestoneId String         @db.Uuid
  actorId     String         @db.Uuid
  status      ApprovalStatus
  note        String?
  actedAt     DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone  ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  actor      User           @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([projectId, milestoneId, actedAt])
}

model ProjectMessage {
  id         String       @id @default(uuid()) @db.Uuid
  projectId  String       @db.Uuid
  authorId   String       @db.Uuid
  body       String
  readAt     DateTime?
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User         @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  attachments ProjectMessageAttachment[]
  createdAt  DateTime     @default(now())
  @@index([projectId, createdAt])
}

model ProjectMessageAttachment {
  id          String         @id @default(uuid()) @db.Uuid
  messageId   String         @db.Uuid
  storageKey  String
  fileName    String
  mimeType    String
  fileSize    Int
  message     ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
}

model ProjectFile {
  id           String              @id @default(uuid()) @db.Uuid
  projectId    String              @db.Uuid
  uploadedById String              @db.Uuid
  category     String
  version      Int                 @default(1)
  fileName     String
  storageKey   String
  mimeType     String
  fileSize     Int
  checksum     String
  visibility   ProjectFileVisibility @default(CLIENT)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User               @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  events       ProjectFileEvent[]
  createdAt    DateTime            @default(now())
  @@index([projectId, category, createdAt])
}

model ProjectFileEvent {
  id        String      @id @default(uuid()) @db.Uuid
  fileId   String      @db.Uuid
  userId   String      @db.Uuid
  action    String
  file      ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())
  @@index([fileId, createdAt])
}

model ProjectActivity {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  metadata  Json?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([projectId, createdAt])
}

model ProjectInvoice {
  id          String               @id @default(uuid()) @db.Uuid
  projectId   String               @db.Uuid
  clientId    String               @db.Uuid
  invoiceNumber String             @unique
  status      ProjectInvoiceStatus @default(DRAFT)
  subtotalMmk Int
  totalMmk    Int
  amountPaidMmk Int                @default(0)
  dueDate     DateTime?
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client      User                 @relation("InvoiceClient", fields: [clientId], references: [id], onDelete: Restrict)
  items       ProjectInvoiceItem[]
  payments    ProjectPaymentSubmission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@index([projectId, status, dueDate])
  @@index([clientId, status])
}

model ProjectInvoiceItem {
  id          String         @id @default(uuid()) @db.Uuid
  invoiceId   String         @db.Uuid
  description String
  amountMmk   Int
  invoice     ProjectInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ProjectPaymentSubmission {
  id                   String               @id @default(uuid()) @db.Uuid
  invoiceId            String               @db.Uuid
  paymentMethodId      String               @db.Uuid
  submittedById        String               @db.Uuid
  amountMmk            Int
  currency             String               @default("MMK")
  transactionReference String
  proofStorageKey      String
  proofMimeType        String
  status               ProjectPaymentStatus @default(PENDING)
  idempotencyKey       String               @unique
  invoice              ProjectInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentMethod        PaymentMethod       @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  submittedBy          User               @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  review               ProjectPaymentReview?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  @@index([invoiceId, status, createdAt])
}

model ProjectPaymentReview {
  id              String               @id @default(uuid()) @db.Uuid
  submissionId    String               @unique @db.Uuid
  reviewerId      String               @db.Uuid
  decision        ProjectPaymentStatus
  rejectionReason String?
  reviewedAt      DateTime             @default(now())
  submission      ProjectPaymentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer        User                 @relation("ProjectPaymentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}
