model ProposalItem {
  id           String          @id @default(uuid()) @db.Uuid
  versionId    String          @db.Uuid
  description  String
  quantity     Int             @default(1)
  unitPriceMmk Int
  totalMmk     Int
  version      ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model Project {
  id                   String             @id @default(uuid()) @db.Uuid
  projectNumber        String             @unique
  requestId            String             @unique @db.Uuid
  proposalId           String             @unique @db.Uuid
  clientId             String             @db.Uuid
  assignedAdminId      String?            @db.Uuid
  status               ProjectStatus      @default(AWAITING_DEPOSIT)
  budgetMmk            Int
  startDate            DateTime?
  targetCompletionDate DateTime?
  request              ProjectRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  proposal             Proposal           @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  client               User               @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  assignedAdmin        User?              @relation("AssignedProjects", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  milestones           ProjectMilestone[]
  approvals            ProjectApproval[]
  messages             ProjectMessage[]
  files                ProjectFile[]
  invoices             ProjectInvoice[]
  activities           ProjectActivity[]
  supportTickets       SupportTicket[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, updatedAt])
  @@index([clientId, status])
  @@index([assignedAdminId, status])
}

model ProjectMilestone {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @db.Uuid
  ownerId     String?           @db.Uuid
  name        String
  description String?
  weight      Int
  status      MilestoneStatus   @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?             @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvals   ProjectApproval[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId, status, dueDate])
}

model ProjectApproval {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @db.Uuid
  milestoneId String           @db.Uuid
  actorId     String           @db.Uuid
  status      ApprovalStatus
  note        String?
  actedAt     DateTime         @default(now())
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  actor       User             @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, milestoneId, actedAt])
}

model ProjectMessage {
  id          String                     @id @default(uuid()) @db.Uuid
  projectId   String                     @db.Uuid
  authorId    String                     @db.Uuid
  body        String
  readAt      DateTime?
  project     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User                       @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  attachments ProjectMessageAttachment[]
  createdAt   DateTime                   @default(now())

  @@index([projectId, createdAt])
}

model ProjectMessageAttachment {
  id         String         @id @default(uuid()) @db.Uuid
  messageId  String         @db.Uuid
  storageKey String
  fileName   String
  mimeType   String
  fileSize   Int
  message    ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
}

model ProjectFile {
  id           String                @id @default(uuid()) @db.Uuid
  projectId    String                @db.Uuid
  uploadedById String                @db.Uuid
  category     String
  version      Int                   @default(1)
  fileName     String
  storageKey   String
  mimeType     String
  fileSize     Int
  checksum     String
  visibility   ProjectFileVisibility @default(CLIENT)
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User                  @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  events       ProjectFileEvent[]
  createdAt    DateTime              @default(now())

  @@index([projectId, category, createdAt])
}

model ProjectFileEvent {
  id        String      @id @default(uuid()) @db.Uuid
  fileId    String      @db.Uuid
  userId    String      @db.Uuid
  action    String
  file      ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())

  @@index([fileId, createdAt])
}

model ProjectActivity {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  metadata  Json?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model ProjectInvoice {
  id             String                     @id @default(uuid()) @db.Uuid
  projectId      String                     @db.Uuid
  clientId       String                     @db.Uuid
  invoiceNumber  String                     @unique
  status         ProjectInvoiceStatus       @default(DRAFT)
  subtotalMmk    Int
  totalMmk       Int
  amountPaidMmk  Int                        @default(0)
  dueDate        DateTime?
  project        Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client         User                       @relation("InvoiceClient", fields: [clientId], references: [id], onDelete: Restrict)
  items          ProjectInvoiceItem[]
  payments       ProjectPaymentSubmission[]
  refundRequests RefundRequest[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([projectId, status, dueDate])
  @@index([clientId, status])
}

model ProjectInvoiceItem {
  id          String         @id @default(uuid()) @db.Uuid
  invoiceId   String         @db.Uuid
  description String
  amountMmk   Int
  invoice     ProjectInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ProjectPaymentSubmission {
  id                   String                @id @default(uuid()) @db.Uuid
  invoiceId            String                @db.Uuid
  paymentMethodId      String                @db.Uuid
  submittedById        String                @db.Uuid
  amountMmk            Int
  currency             String                @default("MMK")
  transactionReference String
  proofStorageKey      String
  proofMimeType        String
  status               ProjectPaymentStatus  @default(PENDING)
  idempotencyKey       String                @unique
  invoice              ProjectInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentMethod        PaymentMethod         @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  submittedBy          User                  @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  review               ProjectPaymentReview?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([invoiceId, status, createdAt])
}

model ProjectPaymentReview {
  id              String                   @id @default(uuid()) @db.Uuid
  submissionId    String                   @unique @db.Uuid
  reviewerId      String                   @db.Uuid
  decision        ProjectPaymentStatus
  rejectionReason String?
  reviewedAt      DateTime                 @default(now())
  submission      ProjectPaymentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer        User                     @relation("ProjectPaymentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AnalyticsEvent {
  id             String   @id @default(uuid()) @db.Uuid
  eventName      String
  userId         String?  @db.Uuid
  anonymousId    String?
  sessionId      String?
  path           String?
  payload        Json?
  idempotencyKey String?  @unique
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, occurredAt])
  @@index([userId, occurredAt])
  @@index([anonymousId, occurredAt])
}

model MarketingConsent {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  marketingEmail Boolean   @default(false)
  source         String?
  consentedAt    DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([marketingEmail, updatedAt])
}

model MarketingCampaign {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String
  type        String
  objective   String
  audience    Json?
  startsAt    DateTime?
  endsAt      DateTime?
  budgetMmk   Int?
  status      MarketingCampaignStatus @default(DRAFT)
  publishedAt DateTime?
  createdById String                  @db.Uuid
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  createdBy   User                    @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, startsAt, endsAt])
  @@index([createdById, createdAt])
}

model VendorProfile {
  id               String                 @id @default(uuid()) @db.Uuid
  ownerId          String                 @db.Uuid
  storeName        String
  storeSlug        String                 @unique
  storeDescription String
  contactEmail     String
  portfolioUrl     String?
  logoStorageKey   String?
  bannerStorageKey String?
  isVerified       Boolean                @default(false)
  isSuspended      Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  owner            User                   @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  applications     VendorApplication[]
  members          VendorMember[]
  products         Template[]
  commissionRules  VendorCommissionRule[]
  earnings         VendorEarning[]
  ledgerEntries    VendorLedgerEntry[]
  payoutAccounts   VendorPayoutAccount[]
  payoutRequests   VendorPayoutRequest[]
  orderItems       OrderItem[]

  @@index([ownerId, isSuspended])
  @@index([isVerified, isSuspended])
}

model VendorApplication {
  id                     String                  @id @default(uuid()) @db.Uuid
  applicantId            String                  @db.Uuid
  vendorId               String?                 @db.Uuid
  sellerType             String
  storeName              String
  storeSlug              String
  storeDescription       String
  contactEmail           String
  portfolioUrl           String?
  businessInformation    String?
  verificationStorageKey String?
  termsAcceptedAt        DateTime?
  status                 VendorApplicationStatus @default(DRAFT)
  reviewerId             String?                 @db.Uuid
  reviewerNote           String?
  reviewedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  applicant              User                    @relation("VendorApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  vendor                 VendorProfile?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  reviewer               User?                   @relation("VendorReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([applicantId, status, createdAt])
  @@index([status, createdAt])
}

model VendorMember {
  id         String           @id @default(uuid()) @db.Uuid
  vendorId   String           @db.Uuid
  userId     String           @db.Uuid
  role       VendorMemberRole
  invitedAt  DateTime         @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?
  vendor     VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vendorId, userId])
  @@index([userId, revokedAt])
}

model VendorCommissionRule {
  id          String         @id @default(uuid()) @db.Uuid
  vendorId    String?        @db.Uuid
  categoryId  String?        @db.Uuid
  rateBps     Int
  effectiveAt DateTime
  endedAt     DateTime?
  reason      String?
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now())
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([vendorId, effectiveAt])
  @@index([categoryId, effectiveAt])
}

model VendorEarning {
  id                    String              @id @default(uuid()) @db.Uuid
  vendorId              String              @db.Uuid
  orderItemId           String              @unique @db.Uuid
  grossMmk              Int
  platformCommissionMmk Int
  netMmk                Int
  availableAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  vendor                VendorProfile       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderItem             OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  ledgerEntries         VendorLedgerEntry[]

  @@index([vendorId, availableAt, createdAt])
}

model VendorLedgerEntry {
  id             String                @id @default(uuid()) @db.Uuid
  vendorId       String                @db.Uuid
  earningId      String?               @db.Uuid
  actorId        String?               @db.Uuid
  eventType      VendorLedgerEventType
  amountMmk      Int
  sourceType     String
  sourceId       String
  idempotencyKey String                @unique
  reason         String?
  createdAt      DateTime              @default(now())
  vendor         VendorProfile         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  earning        VendorEarning?        @relation(fields: [earningId], references: [id], onDelete: SetNull)
  actor          User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([eventType, sourceType, sourceId])
  @@index([vendorId, createdAt])
}

model VendorPayoutAccount {
  id             String                @id @default(uuid()) @db.Uuid
  vendorId       String                @db.Uuid
  method         String
  accountName    String
  accountNumber  String
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  vendor         VendorProfile         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payoutRequests VendorPayoutRequest[]

  @@index([vendorId, isActive])
}

model VendorPayoutRequest {
  id             String                   @id @default(uuid()) @db.Uuid
  vendorId       String                   @db.Uuid
  accountId      String                   @db.Uuid
  amountMmk      Int
  currency       String                   @default("MMK")
  status         VendorPayoutStatus       @default(REQUESTED)
  idempotencyKey String                   @unique
  reviewerId     String?                  @db.Uuid
  reviewerNote   String?
  requestedAt    DateTime                 @default(now())
  reviewedAt     DateTime?
  paidAt         DateTime?
  vendor         VendorProfile            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  account        VendorPayoutAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reviewer       User?                    @relation("PayoutReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  transaction    VendorPayoutTransaction?

  @@index([vendorId, status, requestedAt])
}

model VendorPayoutTransaction {
  id                   String              @id @default(uuid()) @db.Uuid
  payoutRequestId      String              @unique @db.Uuid
  amountMmk            Int
  method               String
  transactionReference String?
  confirmedById        String?             @db.Uuid
  confirmedAt          DateTime?
  createdAt            DateTime            @default(now())
  payoutRequest        VendorPayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  confirmedBy          User?               @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
}

model SupportCategory {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique
  slug        String          @unique
  description String?
  sortOrder   Int             @default(0)
  isEnabled   Boolean         @default(true)
  tickets     SupportTicket[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isEnabled, sortOrder])
}

model SupportTicket {
  id                  String                 @id @default(uuid()) @db.Uuid
  ticketNumber        String                 @unique
  customerId          String                 @db.Uuid
  categoryId          String                 @db.Uuid
  assignedAgentId     String?                @db.Uuid
  subject             String
  description         String
  status              SupportTicketStatus    @default(OPEN)
  priority            SupportPriority        @default(NORMAL)
  firstResponseAt     DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  slaResponseDueAt    DateTime?
  slaResolutionDueAt  DateTime?
  relatedOrderId      String?                @db.Uuid
  relatedProjectId    String?                @db.Uuid
  relatedEnrollmentId String?                @db.Uuid
  customer            User                   @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  category            SupportCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedAgent       User?                  @relation("TicketAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  relatedOrder        Order?                 @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedProject      Project?               @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  relatedEnrollment   CourseEnrollment?      @relation(fields: [relatedEnrollmentId], references: [id], onDelete: SetNull)
  messages            SupportMessage[]
  attachments         SupportAttachment[]
  assignments         SupportAssignment[]
  statusHistory       SupportStatusHistory[]
  feedback            SupportFeedback?
  refundRequests      RefundRequest[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([customerId, status, createdAt])
  @@index([assignedAgentId, status, updatedAt])
  @@index([categoryId, status, createdAt])
  @@index([status, priority, updatedAt])
}

model SupportMessage {
  id          String              @id @default(uuid()) @db.Uuid
  ticketId    String              @db.Uuid
  senderId    String              @db.Uuid
  body        String
  isInternal  Boolean             @default(false)
  readAt      DateTime?
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments SupportAttachment[]
  createdAt   DateTime            @default(now())

  @@index([ticketId, isInternal, createdAt])
}

model SupportAttachment {
  id           String          @id @default(uuid()) @db.Uuid
  ticketId     String          @db.Uuid
  messageId    String?         @db.Uuid
  uploadedById String          @db.Uuid
  storageKey   String
  fileName     String
  mimeType     String
  fileSize     Int
  ticket       SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message      SupportMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now())

  @@index([ticketId, createdAt])
  @@index([messageId])
}

model SupportAssignment {
  id           String        @id @default(uuid()) @db.Uuid
  ticketId     String        @db.Uuid
  agentId      String        @db.Uuid
  assignedById String        @db.Uuid
  assignedAt   DateTime      @default(now())
  unassignedAt DateTime?
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agent        User          @relation("SupportAgent", fields: [agentId], references: [id], onDelete: Restrict)
  assignedBy   User          @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([ticketId, assignedAt])
  @@index([agentId, unassignedAt])
}

model SupportStatusHistory {
  id         String               @id @default(uuid()) @db.Uuid
  ticketId   String               @db.Uuid
  actorId    String               @db.Uuid
  fromStatus SupportTicketStatus?
  toStatus   SupportTicketStatus
  reason     String?
  ticket     SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor      User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt  DateTime             @default(now())

  @@index([ticketId, createdAt])
}

model SupportSlaPolicy {
  id                   String          @id @default(uuid()) @db.Uuid
  priority             SupportPriority @unique
  firstResponseMinutes Int
  resolutionMinutes    Int
  timezone             String          @default("Asia/Yangon")
  pauseWhileWaiting    Boolean         @default(true)
  isEnabled            Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model KnowledgeCategory {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique
  slug        String             @unique
  description String?
  articles    KnowledgeArticle[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model KnowledgeArticle {
  id             String            @id @default(uuid()) @db.Uuid
  slug           String            @unique
  title          String
  excerpt        String
  content        Json
  categoryId     String            @db.Uuid
  authorId       String            @db.Uuid
  status         KnowledgeStatus   @default(DRAFT)
  isFeatured     Boolean           @default(false)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  category       KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author         User              @relation("KnowledgeAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  feedback       SupportFeedback[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status])
}

model RefundRequest {
  id                         String          @id @default(uuid()) @db.Uuid
  requestNumber              String          @unique
  customerId                 String          @db.Uuid
  ticketId                   String?         @db.Uuid
  orderId                    String?         @db.Uuid
  coursePurchaseId           String?         @db.Uuid
  projectInvoiceId           String?         @db.Uuid
  requestedAmountMmk         Int
  approvedAmountMmk          Int?
  currency                   String          @default("MMK")
  reason                     String
  evidenceStorageKey         String?
  status                     RefundStatus    @default(REQUESTED)
  reviewerId                 String?         @db.Uuid
  reviewerNote               String?
  refundTransactionReference String?
  reviewedAt                 DateTime?
  completedAt                DateTime?
  customer                   User            @relation("RefundCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  ticket                     SupportTicket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  order                      Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  coursePurchase             CoursePurchase? @relation(fields: [coursePurchaseId], references: [id], onDelete: Restrict)
  projectInvoice             ProjectInvoice? @relation(fields: [projectInvoiceId], references: [id], onDelete: Restrict)
  reviewer                   User?           @relation("RefundReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([customerId, status, createdAt])
  @@index([status, createdAt])
}

model SupportFeedback {
  id         String            @id @default(uuid()) @db.Uuid
  ticketId   String?           @unique @db.Uuid
  articleId  String?           @db.Uuid
  customerId String            @db.Uuid
  rating     Int
  comment    String?
  ticket     SupportTicket?    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  article    KnowledgeArticle? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  customer   User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@index([articleId, createdAt])
  @@index([customerId, createdAt])
}

model SupportMacro {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  body        String
  isEnabled   Boolean  @default(true)
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiProvider {
  id          String      @id @default(uuid()) @db.Uuid
  key         String      @unique
  displayName String
  isEnabled   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  models      AiModel[]
  usageRecords AiUsageRecord[]
}

model AiModel {
  id           String      @id @default(uuid()) @db.Uuid
  providerId   String      @db.Uuid
  key          String
  displayName  String
  capabilities Json
  isEnabled    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  provider     AiProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  usageRecords AiUsageRecord[]

  @@unique([providerId, key])
  @@index([isEnabled])
}

