# The framework sets NODE_ENV automatically. Set production/staging explicitly
# in the deployment environment when running outside Next.js tooling.
NODE_ENV="development"

DATABASE_URL="postgresql://postgres:password@localhost:5432/nova_studio?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
PUBLIC_WEBSITE_URL="http://localhost:3000"

# Used only by the one-time admin:create command. Never commit real credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-long-random-password"

# Current private-file adapter. This must point to persistent private storage in
# a single-server deployment. Vercel/serverless deployment is blocked until an
# object-storage adapter is implemented.
PRIVATE_STORAGE_DIR="./.private-storage"
